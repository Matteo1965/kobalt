+static int huReplacementWidth( LVFont * font, const lChar32 * text, int len, int break_after, int letter_spacing, TextLangCfg * lang_cfg ) {
+    lChar32 replacement[2];
+    int replacement_len = huHyphenReplacement(text, len, break_after, replacement);
+    if ( !font || !replacement_len )
+        return 0;
+    int prefix_len = break_after + 1;
+    lString32 rendered_prefix;
+    rendered_prefix.append(text, prefix_len);
+    for ( int i=0; i<replacement_len; i++ )
+        rendered_prefix << replacement[i];
+    // Use the same measurement API as the paragraph formatter.  In
+    // particular, getTextWidth() does not accept the paragraph's letter
+    // spacing, while measureText() does.
+    // Hungarian replacement sequences are at most two characters long.
+    // Avoid unbounded stack allocations when measuring unusually long words.
+    int shaped_extra = 0;
+    if ( prefix_len > 0 && prefix_len + replacement_len <= 127 ) {
+        lUInt16 original_widths[128];
+        lUInt8 original_flags[128];
+        lUInt16 rendered_widths[128];
+        lUInt8 rendered_flags[128];
+        font->measureText(text, prefix_len, original_widths, original_flags,
+                          0x7FFF, '?', lang_cfg, letter_spacing, false);
+        font->measureText(rendered_prefix.c_str(), rendered_prefix.length(),
+                          rendered_widths, rendered_flags,
+                          0x7FFF, '?', lang_cfg, letter_spacing, false);
+        int original_width = original_widths[prefix_len - 1];
+        int rendered_width = rendered_widths[rendered_prefix.length() - 1];
+        shaped_extra = rendered_width > original_width
+                        ? rendered_width - original_width : 0;
+    }
+    int glyph_extra = 0;
+    for ( int i=0; i<replacement_len; i++ )
+        glyph_extra += font->getCharWidth(replacement[i]);
+    // Never reserve less than the previous implementation did.
+    // The appended replacement glyph(s) are also subject to the
+    // same letter spacing passed to DrawTextString().
+    // measureText() already included letter spacing in shaped_extra.
+    // Keep the legacy advance + tracking as a conservative lower bound.
+    int glyph_with_spacing = glyph_extra;
+    if ( letter_spacing > 0 )
+        glyph_with_spacing += replacement_len * letter_spacing;
+    return shaped_extra > glyph_with_spacing ? shaped_extra : glyph_with_spacing;
+}
